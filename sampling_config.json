{
  "_comment": [
    "Rules are evaluated in order; the first one whose conditions ALL match wins.",
    "Order matters: put the keep-everything rules first, or they get sampled away.",
    "Events matching nothing use default_sample_rate.",
    "sample_rate is a percentage: 100 keeps everything, 10 keeps ~1 in 10, 0 drops all.",
    "Prefer rates that divide 100 evenly (50, 25, 20, 10, 5, 4, 2, 1).",
    "paths are dotted: response.status, request.verb, request.headers.x-client-id",
    "operator is one of: equals, not_equals, in, not_in, regex, contains, gt, gte, lt, lte, between, exists, not_exists"
  ],

  "default_sample_rate": 100,

  "rules": [
    {
      "name": "keep all errors",
      "sample_rate": 100,
      "conditions": [
        { "path": "response.status", "operator": "gte", "value": 400 }
      ]
    },
    {
      "name": "keep all writes",
      "sample_rate": 100,
      "conditions": [
        { "path": "request.verb", "operator": "not_in", "value": ["GET", "HEAD", "OPTIONS"], "ignore_case": true }
      ]
    },
    {
      "name": "drop health checks",
      "sample_rate": 0,
      "conditions": [
        { "path": "request.route", "operator": "regex", "value": "^/(health|healthz|ping)/?$", "ignore_case": true }
      ]
    },
    {
      "name": "high-volume client: successful reads at 10%",
      "sample_rate": 10,
      "conditions": [
        { "path": "company_id", "operator": "equals", "value": "acme-corp" },
        { "path": "response.status", "operator": "between", "value": [200, 399] }
      ]
    }
  ]
}
